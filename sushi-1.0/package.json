{
    "name": "@girs/sushi-1.0",
    "version": "4.4.0",
    "description": "GJS TypeScript type definitions for Sushi-1.0",
    "type": "module",
    "module": "sushi-1.0.js",
    "main": "sushi-1.0.js",
    "exports": {
      "./ambient": {
        "types": "./sushi-1.0-ambient.d.ts",
        "import": "./sushi-1.0-ambient.js",
        "default": "./sushi-1.0-ambient.js"
      },
      "./import": {
        "types": "./sushi-1.0-import.d.ts",
        "import": "./sushi-1.0-import.js",
        "default": "./sushi-1.0-import.js"
      },
      "./surface": {
        "types": "./sushi-1.0-surface.d.ts",
        "import": "./sushi-1.0-surface.js",
        "default": "./sushi-1.0-surface.js"
      },
      "./sushi-1.0": {
        "types": "./sushi-1.0.d.ts",
        "import": "./sushi-1.0.js",
        "default": "./sushi-1.0.js"
      },
      ".": {
        "types": "./index.d.ts",
        "import": "./index.js",
        "default": "./index.js"
      }
    },
    "scripts": {
      "test": "tsc --project tsconfig.json"
    },
    "dependencies": {
      "@girs/gjs": "^4.4.0",
      "@girs/papersview-4.0": "^4.4.0",
      "@girs/papersdocument-4.0": "^4.4.0",
      "@girs/pango-1.0": "^4.4.0",
      "@girs/cairo-1.0": "^4.4.0",
      "@girs/gobject-2.0": "^4.4.0",
      "@girs/glib-2.0": "^4.4.0",
      "@girs/harfbuzz-0.0": "^4.4.0",
      "@girs/freetype2-2.0": "^4.4.0",
      "@girs/gio-2.0": "^4.4.0",
      "@girs/gmodule-2.0": "^4.4.0",
      "@girs/gtk-4.0": "^4.4.0",
      "@girs/gsk-4.0": "^4.4.0",
      "@girs/graphene-1.0": "^4.4.0",
      "@girs/gdk-4.0": "^4.4.0",
      "@girs/pangocairo-1.0": "^4.4.0",
      "@girs/gdkpixbuf-2.0": "^4.4.0",
      "@girs/gsttag-1.0": "^4.4.0",
      "@girs/gstbase-1.0": "^4.4.0",
      "@girs/gst-1.0": "^4.4.0"    },
    "devDependencies": {
      "typescript": "*"
