{
    "name": "@girs/braseroburn-3.1",
    "version": "4.5.0",
    "description": "GJS TypeScript type definitions for BraseroBurn-3.1",
    "type": "module",
    "module": "braseroburn-3.1.js",
    "main": "braseroburn-3.1.js",
    "exports": {
      "./ambient": {
        "types": "./braseroburn-3.1-ambient.d.ts",
        "import": "./braseroburn-3.1-ambient.js",
        "default": "./braseroburn-3.1-ambient.js"
      },
      "./import": {
        "types": "./braseroburn-3.1-import.d.ts",
        "import": "./braseroburn-3.1-import.js",
        "default": "./braseroburn-3.1-import.js"
      },
      "./vocabulary": {
        "types": "./braseroburn-3.1-vocabulary.d.ts",
        "import": "./braseroburn-3.1-vocabulary.js",
        "default": "./braseroburn-3.1-vocabulary.js"
      },
      "./braseroburn-3.1": {
        "types": "./braseroburn-3.1.d.ts",
        "import": "./braseroburn-3.1.js",
        "default": "./braseroburn-3.1.js"
      },
      ".": {
        "types": "./index.d.ts",
        "import": "./index.js",
        "default": "./index.js"
      }
    },
    "scripts": {
      "test": "tsc --project tsconfig.json"
    },
    "dependencies": {
      "@girs/gjs": "^4.5.0",
      "@girs/gtk-3.0": "^4.5.0",
      "@girs/xlib-2.0": "^4.5.0",
      "@girs/gdk-3.0": "^4.5.0",
      "@girs/cairo-1.0": "^4.5.0",
      "@girs/gobject-2.0": "^4.5.0",
      "@girs/glib-2.0": "^4.5.0",
      "@girs/pango-1.0": "^4.5.0",
      "@girs/harfbuzz-0.0": "^4.5.0",
      "@girs/freetype2-2.0": "^4.5.0",
      "@girs/gio-2.0": "^4.5.0",
      "@girs/gmodule-2.0": "^4.5.0",
      "@girs/gdkpixbuf-2.0": "^4.5.0",
      "@girs/atk-1.0": "^4.5.0"    },
    "devDependencies": {
      "typescript": "*"
    },
    "keywords": ["Gir", "TypeScript", "types", "GObject-Introspection", "GJS", "BraseroBurn-3.1"],
    "author": "ts-for-gir",
    "license": "MIT",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/gjsify/types.git"
    },
    "bugs": {
      "url": "https://github.com/gjsify/ts-for-gir/issues"
    },
    "homepage": "https://github.com/gjsify/types/tree/main/braseroburn-3.1#readme"
}


