{
    "name": "@girs/papersview-4.0",
    "version": "4.7.0",
    "description": "GJS TypeScript type definitions for PapersView-4.0",
    "type": "module",
    "module": "papersview-4.0.js",
    "main": "papersview-4.0.js",
    "exports": {
      "./ambient": {
        "types": "./papersview-4.0-ambient.d.ts",
        "import": "./papersview-4.0-ambient.js",
        "default": "./papersview-4.0-ambient.js"
      },
      "./import": {
        "types": "./papersview-4.0-import.d.ts",
        "import": "./papersview-4.0-import.js",
        "default": "./papersview-4.0-import.js"
      },
      "./vocabulary": {
        "types": "./papersview-4.0-vocabulary.d.ts",
        "import": "./papersview-4.0-vocabulary.js",
        "default": "./papersview-4.0-vocabulary.js"
      },
      "./papersview-4.0": {
        "types": "./papersview-4.0.d.ts",
        "import": "./papersview-4.0.js",
        "default": "./papersview-4.0.js"
      },
      ".": {
        "types": "./index.d.ts",
        "import": "./index.js",
        "default": "./index.js"
      }
    },
    "scripts": {
      "test": "tsc --project tsconfig.json"
    },
    "dependencies": {
      "@girs/gjs": "^4.7.0",
      "@girs/papersdocument-4.0": "^4.7.0",
      "@girs/pango-1.0": "^4.7.0",
      "@girs/cairo-1.0": "^4.7.0",
      "@girs/gobject-2.0": "^4.7.0",
      "@girs/glib-2.0": "^4.7.0",
      "@girs/harfbuzz-0.0": "^4.7.0",
      "@girs/freetype2-2.0": "^4.7.0",
      "@girs/gio-2.0": "^4.7.0",
      "@girs/gmodule-2.0": "^4.7.0",
      "@girs/gtk-4.0": "^4.7.0",
      "@girs/gsk-4.0": "^4.7.0",
      "@girs/graphene-1.0": "^4.7.0",
      "@girs/gdk-4.0": "^4.7.0",
      "@girs/pangocairo-1.0": "^4.7.0",
      "@girs/gdkpixbuf-2.0": "^4.7.0"    },
    "devDependencies": {
      "typescript": "*"
    },
    "keywords": ["Gir", "TypeScript", "types", "GObject-Introspection", "GJS", "PapersView-4.0"],
